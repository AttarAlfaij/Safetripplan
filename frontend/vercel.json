{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://safetripplan-updatedversion-1.onrender.com/api/:path*"
    },
    {
      "source": "/oauth2/:path*",
      "destination": "https://safetripplan-updatedversion-1.onrender.com/oauth2/:path*"
    },
    {
      "source": "/login/oauth2/:path*",
      "destination": "https://safetripplan-updatedversion-1.onrender.com/login/oauth2/:path*"
    },
    {
      "source": "/logout",
      "destination": "https://safetripplan-updatedversion-1.onrender.com/logout"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
